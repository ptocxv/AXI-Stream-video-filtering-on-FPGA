search -exists inst *
#R 1
pick * -hier 1300 532
property selectattr 0
pick port 1300 532
pick portBus 1300 532
pick pin 1300 532
pick pinBus 1300 532
pick hierPin 1300 532
pick hierPinBus 1300 532
property selectattr 80
#CMD bind stroke-1 -action {}
#CMD bind stroke-nw-1 -action callback -echo_type line -echo_text {Zoom fit} -format (#F7F8F9,#242831,1.0)
pagesize
#R 2582 1248
#CMD bind stroke-ne-1 -action zoom_out -echo_type line -echo_text {Zoom -%z} -format (#F7F8F9,#242831,1.0)
#CMD bind stroke-se-1 -action callback -echo_type rectangle -autoscroll -echo_text {Zoom area} -format (#F7F8F9,#242831,1.0)
#CMD bind stroke-sw-1 -action zoom_in2 -echo_type line -echo_text {Zoom +%z} -format (#F7F8F9,#242831,1.0)
property rubberbandfontsize 13
property rubberbandcolor #f7f8f9
pick cgraphic 1300 532
pick port 1300 532
pick portBus 1300 532
pick * -hier 1300 532
pick -selectattr 2 * 1300 532
pick * -selectattr 2 1300 532
